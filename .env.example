# DEMO MODE NEEDS NOTHING. Do not add credentials unless Credence has issued them.
# For Live Mode, copy this file to .env.local and fill the three values.

CREDENCE_LICENSE_KEY=
CREDENCE_PROFILE_ID=
CREDENCE_ORIGIN=https://your-domain-registered-with-credence.example
CREDENCE_BASE_URL=https://credenceid.com/cloudsdk/playground
PORT=3000
# Leave unset locally. Set HOST=0.0.0.0 on a hosting platform such as Render.
HOST=
